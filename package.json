{
  "name": "vee-software",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @vee/web --filter @vee/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "type": "module"
}
